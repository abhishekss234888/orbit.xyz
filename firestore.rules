rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    function validKey(k) {
      return k.keys().hasOnly(['kty', 'crv', 'x', 'y']) && k.kty == 'EC' && k.crv == 'P-256'
        && k.x is string && k.y is string && k.x.size() <= 64 && k.y.size() <= 64;
    }
    function validUser(d, uid) {
      return d.keys().hasOnly(['uid', 'username', 'usernameLower', 'name', 'photoURL', 'bio', 'lastSeen', 'createdAt', 'updatedAt', 'settings', 'publicKey'])
        && d.uid == uid
        && d.username.matches('^[a-zA-Z0-9_]{3,20}$')
        && d.usernameLower == d.username.lower()
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.get('bio', '').size() <= 120
        && (!('publicKey' in d) || validKey(d.publicKey));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && validUser(request.resource.data, uid);
      allow update: if isSelf(uid) && validUser(request.resource.data, uid)
        && request.resource.data.usernameLower == resource.data.usernameLower;
      allow delete: if false;

      match /chatIndex/{chatId} { allow read, write: if isSelf(uid); }
      match /blocked/{targetUid} { allow read, write: if isSelf(uid); }
      // passphrase-wrapped backup of the encryption key; only ciphertext, readable only by its owner
      match /vault/{docId} {
        allow read: if isSelf(uid);
        allow write: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['v', 'it', 'salt', 'iv', 'ct'])
          && request.resource.data.ct is string && request.resource.data.ct.size() <= 4000;
      }
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(name))
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lastMessage == null
        && ((request.resource.data.type == 'direct'
              && request.resource.data.memberIds.size() == 2
              && request.resource.data.memberIds[0] < request.resource.data.memberIds[1]
              && chatId == request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1])
            || (request.resource.data.type == 'group'
                && request.resource.data.memberIds.size() >= 2 && request.resource.data.memberIds.size() <= 256
                && request.resource.data.admins == [request.auth.uid]
                && request.resource.data.name is string
                && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40));
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdBy == resource.data.createdBy
        && (request.resource.data.memberIds == resource.data.memberIds
            || (resource.data.type == 'group' && request.auth.uid in resource.data.admins)
            || (resource.data.type == 'group'
                && !(request.auth.uid in request.resource.data.memberIds)
                && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
                && request.resource.data.memberIds.hasAll(resource.data.memberIds.removeAll([request.auth.uid]))))
        && (request.resource.data.lastMessage == resource.data.lastMessage
            || (request.resource.data.lastMessage.senderId == request.auth.uid
                && request.resource.data.lastMessage.enc == 1
                && request.resource.data.lastMessage.at == request.time));
      allow delete: if false;

      // one wrapped copy of the group's AES key per member; only a group admin can hand keys out
      match /keys/{keyUid} {
        allow read: if signedIn() && request.auth.uid == keyUid;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['by', 'text', 'iv'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 200
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group'
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.admins
          && keyUid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        function chatData() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function isMember() { return signedIn() && request.auth.uid in chatData().memberIds; }

        allow read: if isMember();
        // new messages must be ciphertext: enc == 1 with an IV, sealed by the sender's own client
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['text', 'iv', 'enc', 'senderId', 'senderName', 'senderPhotoURL', 'at', 'editedAt', 'deleted', 'readBy'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.enc == 1
          && request.resource.data.iv is string && request.resource.data.iv.size() <= 24
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 12000
          && request.resource.data.at == request.time
          && request.resource.data.deleted == false;
        allow update: if isMember() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid]))
          || (resource.data.senderId == request.auth.uid
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.at == resource.data.at
            && request.resource.data.text.size() <= 12000
            && (request.resource.data.deleted == true
                || (request.time < resource.data.at + duration.value(15, 'm')
                    && request.resource.data.editedAt == request.time)))
        );
        allow delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
